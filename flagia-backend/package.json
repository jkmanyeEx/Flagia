{
  "name": "flagia-backend",
  "version": "1.0.0",
  "description": "Flagia - Academic Writing Integrity Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:engine": "tsx src/engine/flagiaEngine_test.ts",
    "test:linguistic": "tsx src/linguistic/linguistic_test.ts",
    "test:linguistic:runtime": "tsx src/linguistic/runtime_test.ts",
    "test:linguistic:submission": "tsx src/services/submissionAnalysis_test.ts",
    "test:force-submit": "tsx src/force_submit_test.ts",
    "test:replay-protocol": "npm run build --silent && node dist/telemetryValidation_test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
